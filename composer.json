{
    "name": "rokfor/rokfor-slim",
    "description": "Rokfor CMS: Headless CMS with JSON api",
    "keywords": ["rokfor", "slim","framework","view","template","jade"],
    "homepage": "http://cloud.rokfor.ch",
    "license": "MIT",
    "type": "project",
    "time": "2016-02-28",
    "authors": [
        {
            "name": "Rokfor",
            "email": "inquiries@rokfor.ch",
            "homepage": "http://cloud.rokfor.ch"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/urshofer/slim-jade"
        },
        {
            "type": "vcs",
            "url": "https://github.com/urshofer/Propel2"
        },
        {
            "type": "vcs",
            "url": "https://github.com/urshofer/slim-auth"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "slim/slim": "~3.0",
        "jlndk/slim-jade": "dev-pug",
        "propel/propel": "dev-php8 as 2.0.0-alpha8",
        "thefuriouscoder/propel2-data-cache-behavior": "dev-master",
        "intervention/image": "dev-master#032263954ca2a5258fb5fe7492962c1a16ca9f3c",
        "aws/aws-sdk-php": "^3.0",
        "jeremykendall/slim-auth": "dev-slim-3.x",
        "monolog/monolog": "^1.17",
        "slim/csrf": "^0.6.0",
        "slim/flash": "^0.1.0",
        "akrabat/rka-ip-address-middleware": "^0.5.0",
        "palanik/corsslim": "dev-slim3",
        "erusev/parsedown": "^1.6",
        "predis/predis": "^1.0",
        "lcobucci/jwt": "^3.1",
        "phpmailer/phpmailer": "^6.0",
        "ext-imagick": "*",
        "ext-gd": "*",
        "ext-redis": "*"
    },
    "autoload": {
        "psr-4": {"Rokfor\\": "lib/rokfor-db/src/"},
        "classmap": ["lib/rokfor-db/config/generated-classes/"]
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "nodejs-php-fallback/nodejs-php-fallback": true
        }
    }
}
